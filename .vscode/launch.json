{
    "configurations": [

        {
            "name": "C/C++: clang build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [
                "NOM_PREFIX=/Volumes/Projects/ttcards.git/third-party".
