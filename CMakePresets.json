{
  "version": 10,
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "displayName": "Common settings for configure phase",
      "description": "cmake configure phase configuration for building ttcards",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "_CMAKE_INSTALL_PREFIX": "$env{HOME}/local",
        "NOM_USE_CCACHE": "OFF",
        "NOM_USE_DISTCC": "OFF"
      },
      "environment": {
        "DISTCC_VERBOSE": "1"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "displayName": "build project using clang",
      "cacheVariables": {
        "NOM_USE_CCACHE": "ON",
        "NOM_USE_DISTCC": "OFF",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++",
        "DISTCC_VERBOSE": "1"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "displayName": "build project using gcc",
      "cacheVariables": {
        "NOM_USE_CCACHE": "ON",
        "NOM_USE_DISTCC": "OFF",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "environment": {
        "CC": "gcc",
        "CXX": "g++",
        "DISTCC_VERBOSE": "1"
      }
    },
    {
      "name": "xcode",
      "hidden": true,
      "displayName": "(macos) build project using xcode",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "NOM_USE_CCACHE": "ON",
        "NOM_USE_DISTCC": "OFF",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGN_IDENTITY": ""
      },
      "environment": {
        "DISTCC_VERBOSE": "1"
      }
    },
    {
      "name": "msbuild",
      "hidden": true,
      "displayName": "build project using MSBuild",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_GENERATOR_PLATFORM": "x64",
        "CMAKE_GENERATOR_TOOLSET": "ClangCL",
        "NOM_USE_CCACHE": "ON",
        "NOM_USE_DISTCC": "OFF",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ninja",
      "hidden": true,
      "displayName": "build project using ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_GENERATOR_PLATFORM": "x64",
        "NOM_USE_CCACHE": "ON",
        "NOM_USE_DISTCC": "OFF"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "displayName": "vcpkg managed dependencies",
      "description": "use vcpkg for managing dependencies",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "nomlib_DIR": "/usr/local/lib/cmake/nomlib"
      },
      "environment": {
        "DISTCC_VERBOSE": "1",
        "libRocket_INCLUDE_DIRS": "${sourceDir}/vcpkg_installed/$env{VCPKG_TARGET_TRIPLET}/include",
        "nomlib_DIR": "/usr/local/lib/cmake/nomlib"
      }
    },
    {
      "name": "debug",
      "displayName": "Build project with debug syms and statically linked libraries (vcpkg, clang)",
      "inherits": ["common", "vcpkg", "clang"],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "DEBUG": "on",
        "DEBUG_ASSERT": "on",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "environment": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"}
    },
    {
      "name": "debug-dynamic",
      "displayName": "Build project w/ debug syms and dynamically linked libraries (vcpkg, clang)",
      "inherits": ["common", "vcpkg", "clang"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON",
        "DEBUG_ASSERT": "ON",
        "HIDE_SYMBOL_VISIBILITY": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "release",
      "displayName": "Build project release and statically linked libraries (vcpkg, clang)",
      "inherits": ["common", "vcpkg", "clang"],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "DEBUG_ASSERT": "OFF",
        "WARNINGS_AS_ERRORS": "OFF",
        "HIDE_SYMBOL_VISIBILITY": "ON",
        "CMAKE_INSTALL_PREFIX": "/usr/local",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "environment": {
      }
    },
    {
      "name": "release-dynamic",
      "displayName": "Build project release and dynamically linked libraries (vcpkg, clang)",
      "inherits": ["common", "vcpkg", "clang"],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "DEBUG_ASSERT": "OFF",
        "HIDE_SYMBOL_VISIBILITY": "ON",
        "WARNINGS_AS_ERRORS": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr/local",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      },
      "environment": {
      }
    },
    {
      "name": "RelWithDebInfo",
      "displayName": "Build project release with debug syms and dynamically linked libraries (vcpkg, clang)",
      "inherits": ["common", "vcpkg", "clang"],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DEBUG_ASSERT": "ON",
        "HIDE_SYMBOL_VISIBILITY": "ON",
        "CMAKE_VERBOSE_MAKEFILE": "ON",
        "WARNINGS_AS_ERRORS": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "debug-osx",
      "displayName": "(macos) Build project with debug syms and statically linked libraries (vcpkg, clang)",
      "inherits": ["common", "vcpkg", "clang"],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "DEBUG_ASSERT": "ON",
        "CMAKE_INSTALL_PREFIX": "~/Applications/Games",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15"
      },
      "environment": {
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Build defaults on Linux",
      "description": "Build debug target using clang toolchain",
      "displayName": "Build ttcards on Linux",
      "configurePreset": "debug"
    }
  ]
}
